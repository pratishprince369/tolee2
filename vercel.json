{
  "buildCommand": "npm --prefix apps/web run build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "npm --prefix apps/web install",
  "crons": [
    {
      "path": "/api/cron/publish-daily-news",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/publish-youtube-videos",
      "schedule": "0 */2 * * *"
    }
  ]
}
