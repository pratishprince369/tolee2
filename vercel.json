{
  "buildCommand": "npm --prefix apps/web run build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "npm --prefix apps/web install && node apps/web/scripts/link-root-prisma.js",
  "crons": [
    {
      "path": "/api/cron/publish-daily-news",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/publish-daily-reels",
      "schedule": "0 6 * * *"
    }
  ]
}
