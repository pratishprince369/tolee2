  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([roomCode])
  @@index([isLive])
  @@index([hostId])
  @@index([toleeId])
}

model ScheduledSocialPost {
  id           String    @id @default(cuid())
  userId       String
  userName     String?
  userAvatar   String?
  topic        String
  tone         String    @default("viral")
  mediaUrl     String?
  mediaType    String?   // "image" or "video"
  platforms    String[]  @default(["linkedin", "twitter"])
  postsData    Json      // { linkedin: "...", instagram: "...", twitter: "...", facebook: "...", whatsapp: "..." }
  scheduledAt  DateTime
  status       String    @default("SCHEDULED") // "SCHEDULED", "PUBLISHED", "CANCELLED", "FAILED"
  publishedAt  DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([scheduledAt])
  @@index([status])
}

model WhatsAppCampaign {
  id              String    @id @default(cuid())
  userId          String
  userName        String?
  title           String
  messageTemplate String
  mediaUrl        String?
  mediaType       String?   // "image" or "video" or "document"
  contactsData    Json      // Array of { id: string, phone: string, name?: string, customVar?: string, status: 'PENDING'|'SENT'|'SKIPPED' }
  totalContacts   Int       @default(0)
  sentCount       Int       @default(0)
  status          String    @default("DRAFT") // "DRAFT", "IN_PROGRESS", "COMPLETED"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}







