<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic to tolee.in and subdomains for Capacitor WebView -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">tolee.in</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <!-- Default: Allow cleartext traffic (HTTP) for local dev testing -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
